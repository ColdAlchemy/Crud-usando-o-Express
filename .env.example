# Copie para .env (ou defina as variáveis no ambiente). O app NÃO lê o arquivo sozinho:
# use `node --env-file=.env src/server.js` ou o docker compose.

# Obrigatório em produção: um segredo longo e aleatório para assinar os tokens JWT.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000
DB_FILE=estoque.db

# Validade do token, em segundos (padrão: 2 horas)
JWT_EXPIRA_SEGUNDOS=7200

# Tentativas de login/cadastro por IP e janela (padrão: 10 por minuto)
LIMITE_AUTH_MAX=10
LIMITE_AUTH_JANELA_MS=60000

# NODE_ENV=production  (exige JWT_SECRET e esconde a dica da conta de demonstração no console)
